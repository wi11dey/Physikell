cabal-version: 1.12

name:           nature
version:        0.1.0.0
build-type:     Custom

custom-setup
  setup-depends:
      base
    , Cabal
    , graphmod
    , graphviz
    , silently
    , text

library
  exposed-modules:
      Schrodinger
  default-extensions:
      BlockArguments
      ConstraintKinds
      PostfixOperators
      Rank2Types
      TypeOperators
      UnicodeSyntax
      ViewPatterns
  build-depends:
      ad
    , base
    , hmatrix
    , numeric-prelude
    , physics
    , plotlyhs
    , pretty-simple
  default-language: Haskell2010

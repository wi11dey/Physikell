cabal-version: 1.12

name:           microcosm
version:        0.1.0.0
build-type:     Custom

custom-setup
  setup-depends:
      base
    , Cabal
    , graphmod
    , graphviz
    , silently
    , text
    , haskell-src-exts

library
  ghc-options: -Wunused-imports
  exposed-modules:
      Algebra.GradedRing
      Physics.DimensionalAnalysis
      Physics.Quantum.Dirac
      Physics.Quantum.Mechanics
  default-extensions:
      BlockArguments
      ConstraintKinds
      DataKinds
      FlexibleInstances
      FunctionalDependencies
      MultiParamTypeClasses
      PostfixOperators
      Rank2Types
      RebindableSyntax
      ScopedTypeVariables
      TypeApplications
      TypeOperators
      UnicodeSyntax
      ViewPatterns
  build-depends:
      ad
    , base
    , dimensional
    , h-raylib
    , hmatrix
    , numtype-dk
    , numeric-prelude
    , physics
    , pretty-simple
    , waterfall-cad
  default-language: Haskell2010

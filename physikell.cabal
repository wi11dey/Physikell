cabal-version: 1.12

name:           physikell
version:        0.1.0.0
build-type:     Simple

library
  exposed-modules:
      Schrodinger
  default-extensions:
      ConstraintKinds
      RankNTypes
      TypeOperators
      UnicodeSyntax
      ViewPatterns
  build-depends:
      ad
    , base
    , physics
    , numeric-prelude
    , pretty-simple
  default-language: Haskell2010

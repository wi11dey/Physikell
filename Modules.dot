digraph G {
    graph [size="6,4"];
    graph [ratio=fill];
    subgraph cluster_0 {
        graph [label=Mathematics];
        graph [color="#0000000f"];
        graph [style=filled];
        u0 [label=Constants
           ,style=filled
           ,fillcolor="#ffffbb"
           ,penwidth=0];
    }
    subgraph cluster_1 {
